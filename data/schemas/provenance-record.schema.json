{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanatanaai://schemas/provenance-record/v1",
  "title": "SanatanaAI Provenance Record",
  "type": "object",
  "required": ["provenance_id", "claim_id", "evidence", "processing", "evidence_class"],
  "properties": {
    "provenance_id": {"type": "string", "pattern": "^prov-[a-z0-9-]+$"},
    "claim_id": {"type": "string", "pattern": "^claim-[a-z0-9-]+$"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "locator"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^source-[a-z0-9-]+$"},
          "text_id": {"type": "string", "pattern": "^text-[a-z0-9-]+$"},
          "passage_id": {"type": "string", "pattern": "^passage-[a-z0-9-]+$"},
          "locator": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "processing": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_class": {
      "enum": [
        "primary_textual_evidence",
        "traditional_interpretation",
        "scholarly_interpretation",
        "historical_inference",
        "ai_synthesis",
        "uncertainty"
      ]
    }
  },
  "additionalProperties": false
}
