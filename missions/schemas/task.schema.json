{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanatanaai://schemas/task/v1",
  "title": "SanatanaAI Mission Task",
  "type": "object",
  "required": ["task_id", "mission_id", "objective", "agent_id", "status", "dependencies", "checkpoint_required"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"},
    "mission_id": {"type": "string", "pattern": "^mission-[a-z0-9-]+$"},
    "objective": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"},
    "status": {"enum": ["pending", "ready", "running", "blocked", "completed", "failed", "cancelled"]},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^task-[a-z0-9-]+$"}},
    "checkpoint_required": {"type": "boolean"},
    "input_artifacts": {"type": "array", "items": {"type": "string"}},
    "output_artifacts": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
