{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanatanaai://schemas/mission/v1",
  "title": "SanatanaAI Mission",
  "type": "object",
  "required": ["mission_id", "objective", "scope", "constraints", "tasks", "checkpoints", "status"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^mission-[a-z0-9-]+$"},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "tasks": {"type": "array", "items": {"type": "string"}},
    "checkpoints": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["planned", "running", "blocked", "paused", "completed", "failed", "cancelled"]}
  },
  "additionalProperties": false
}
