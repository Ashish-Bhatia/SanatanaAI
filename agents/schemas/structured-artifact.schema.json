{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sanatanaai://schemas/structured-artifact/v1",
  "title": "SanatanaAI Structured Artifact",
  "type": "object",
  "required": ["artifact_id", "artifact_type", "schema_id", "version", "owner_agent_id", "payload", "provenance_ids"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "schema_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "owner_agent_id": {"type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"},
    "payload": {"type": "object"},
    "provenance_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
