{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanatana.ai/schemas/acquisition_record.schema.json",
  "title": "Acquisition Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source_id", "retrieved_at", "retrieval_method", "locator", "content_digest", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "retrieval_method": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "minLength": 1},
    "metadata": {"type": "object", "minProperties": 1, "additionalProperties": true}
  }
}
