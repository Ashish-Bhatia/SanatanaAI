{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanatana.ai/schemas/processing_record.schema.json",
  "title": "Processing Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "operation", "agent_id", "created_at", "input_artifact_ids", "output_artifact_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "input_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  }
}
