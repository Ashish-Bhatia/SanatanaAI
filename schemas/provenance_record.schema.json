{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanatana.ai/schemas/provenance_record.schema.json",
  "title": "Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "artifact_id", "artifact_type", "source_ids", "evidence_class", "created_at", "processing_steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "enum": ["source", "text", "manuscript", "passage", "claim", "entity", "relationship", "article"]},
    "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "evidence_class": {"type": "string", "enum": ["primary_textual_evidence", "traditional_interpretation", "scholarly_interpretation", "historical_inference", "ai_synthesis", "uncertainty"]},
    "created_at": {"type": "string", "format": "date-time"},
    "processing_steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["step_id", "operation", "agent_id"], "properties": {"step_id": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}, "agent_id": {"type": "string", "minLength": 1}, "input_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "output_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}}}
  }
}
